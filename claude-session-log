#!/usr/bin/env bash
# Replicate all non-media application state from one node to the other.
#
# Unlike sync-state.sh (which whitelists a few known sidecar filenames inside
# the movies/series library), this script mirrors entire folders and instead
# EXCLUDES large video payloads by extension. That means it also picks up
# subtitles, posters, .nfo files, and anything else living next to the media
# that sync-state.sh's narrow include-list would silently drop.
#
# Folders covered (see stack.env.example for the *_DIR variables):
#   - movie-streamer-data   (user profiles/config/roster - full mirror, small)
#   - movie-streamer/metadata (catalog metadata - full mirror, small)
#   - movies + series       (everything except video files)
#   - archive (tobedel)     (full mirror, tiny)
#   - subliminal config     (full mirror, tiny)
#   - qbittorrent config    (full mirror, small)
#
# Deliberately NOT covered:
#   - redis/data            Live AOF/RDB files. Copying these while redis is
#                            running risks a corrupt/half-written copy. Redis
#                            replication (if/when added) must use Redis's own
#                            replication protocol, not a file copy.
#   - movie-streamer-cache  Regenerable audio-remux cache (~17G on la today).
#                            Not source-of-truth data; opt in with
#                            SYNC_INCLUDE_AUDIO_CACHE=true if you really want it.

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "$0")" >/dev/null 2>&1 && pwd)
STACK_DIR=$(cd -- "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)
ENV_FILE=${ENV_FILE:-$STACK_DIR/env/stack.env}

# Preserve any safety-relevant overrides the caller passed on the command line -
# sourcing the env file below must not silently clobber an explicit
# `SYNC_DRY_RUN=true ./sync-app-folders.sh` safety check.
for _var in SYNC_DRY_RUN SYNC_DELETE SYNC_INCLUDE_AUDIO_CACHE SYNC_STRICT_HOST_KEY_CHECKING; do
    if [[ -n "${!_var+x}" ]]; then
        declare "_caller_${_var}=${!_var}"
    fi
done

if [[ -f "$ENV_FILE" ]]; then
    set -a
    source "$ENV_FILE"
    set +a
elif [[ -f "$STACK_DIR/env/stack.env.example" ]]; then
    echo "No env/stack.env found, sourcing env/stack.env.example defaults."
    set -a
    source "$STACK_DIR/env/stack.env.example"
    set +a
fi

for _var in SYNC_DRY_RUN SYNC_DELETE SYNC_INCLUDE_AUDIO_CACHE SYNC_STRICT_HOST_KEY_CHECKING; do
    _caller_ref="_caller_${_var}"
    if [[ -n "${!_caller_ref+x}" ]]; then
        declare "${_var}=${!_caller_ref}"
    fi
done

DIRECTION=${1:-la-to-snode}
RSYNC_BIN=${RSYNC_BIN:-rsync}
SSH_BIN=${SSH_BIN:-ssh}

if ! command -v "$RSYNC_BIN" >/dev/null 2>&1; then
    echo "rsync binary not found: $RSYNC_BIN"
    exit 1
fi

if ! command -v "$SSH_BIN" >/dev/null 2>&1; then
    echo "ssh binary not found: $SSH_BIN"
    exit 1
fi

LA_TARGET=${LA_SSH_TARGET:-epic@10.100.0.1}
SNODE_TARGET=${SNODE_SSH_TARGET:-epic@10.100.0.2}

SYNC_DRY_RUN=${SYNC_DRY_RUN:-true}
SYNC_STRICT_HOST_KEY_CHECKING=${SYNC_STRICT_HOST_KEY_CHECKING:-true}
SYNC_SSH_CONNECT_TIMEOUT=${SYNC_SSH_CONNECT_TIMEOUT:-10}
SYNC_INCLUDE_AUDIO_CACHE=${SYNC_INCLUDE_AUDIO_CACHE:-false}
SYNC_DELETE=${SYNC_DELETE:-false}

LA_METADATA_DIR=${LA_METADATA_DIR:-/home/epic/movie-streamer-data}
SNODE_METADATA_DIR=${SNODE_METADATA_DIR:-/home/epic/movie-streamer-data}
LA_CATALOG_METADATA_DIR=${LA_CATALOG_METADATA_DIR:-/home/epic/movie-streamer/metadata}
SNODE_CATALOG_METADATA_DIR=${SNODE_CATALOG_METADATA_DIR:-/home/epic/movie-streamer/metadata}
LA_MOVIES_DIR=${LA_MOVIES_DIR:-/home/epic/movies}
SNODE_MOVIES_DIR=${SNODE_MOVIES_DIR:-/home/epic/movies}
LA_SERIES_DIR=${LA_SERIES_DIR:-/data/blockchain/media/Series}
SNODE_SERIES_DIR=${SNODE_SERIES_DIR:-/data/blockchain/media/Series}
LA_ARCHIVE_DIR=${LA_ARCHIVE_DIR:-/home/epic/tobedel}
SNODE_ARCHIVE_DIR=${SNODE_ARCHIVE_DIR:-/home/epic/tobedel}
LA_SUBLIMINAL_CONFIG_DIR=${LA_SUBLIMINAL_CONFIG_DIR:-/home/epic/.config/subliminal}
SNODE_SUBLIMINAL_CONFIG_DIR=${SNODE_SUBLIMINAL_CONFIG_DIR:-/home/epic/.config/subliminal}
LA_QBIT_CONFIG_DIR=${LA_QBIT_CONFIG_DIR:-/home/epic/qbittorrent/config}
SNODE_QBIT_CONFIG_DIR=${SNODE_QBIT_CONFIG_DIR:-/home/epic/qbittorrent/config}
LA_AUDIO_CACHE_DIR=${LA_AUDIO_CACHE_DIR:-/home/epic/movie-streamer-cache}
SNODE_AUDIO_CACHE_DIR=${SNODE_AUDIO_CACHE_DIR:-/home/epic/movie-streamer-cache}

case "$DIRECTION" in
    la-to-snode)
        SRC_HOST=$LA_TARGET; DST_HOST=$SNODE_TARGET
        SRC_METADATA=$LA_METADATA_DIR; DST_METADATA=$SNODE_METADATA_DIR
        SRC_CATALOG=$LA_CATALOG_METADATA_DIR; DST_CATALOG=$SNODE_CATALOG_METADATA_DIR
        SRC_MOVIES=$LA_MOVIES_DIR; DST_MOVIES=$SNODE_MOVIES_DIR
        SRC_SERIES=$LA_SERIES_DIR; DST_SERIES=$SNODE_SERIES_DIR
        SRC_ARCHIVE=$LA_ARCHIVE_DIR; DST_ARCHIVE=$SNODE_ARCHIVE_DIR
        SRC_SUBLIMINAL=$LA_SUBLIMINAL_CONFIG_DIR; DST_SUBLIMINAL=$SNODE_SUBLIMINAL_CONFIG_DIR
        SRC_QBIT=$LA_QBIT_CONFIG_DIR; DST_QBIT=$SNODE_QBIT_CONFIG_DIR
        SRC_AUDIO_CACHE=$LA_AUDIO_CACHE_DIR; DST_AUDIO_CACHE=$SNODE_AUDIO_CACHE_DIR
        ;;
    snode-to-la)
        SRC_HOST=$SNODE_TARGET; DST_HOST=$LA_TARGET
        SRC_METADATA=$SNODE_METADATA_DIR; DST_METADATA=$LA_METADATA_DIR
        SRC_CATALOG=$SNODE_CATALOG_METADATA_DIR; DST_CATALOG=$LA_CATALOG_METADATA_DIR
        SRC_MOVIES=$SNODE_MOVIES_DIR; DST_MOVIES=$LA_MOVIES_DIR
        SRC_SERIES=$SNODE_SERIES_DIR; DST_SERIES=$LA_SERIES_DIR
        SRC_ARCHIVE=$SNODE_ARCHIVE_DIR; DST_ARCHIVE=$LA_ARCHIVE_DIR
        SRC_SUBLIMINAL=$SNODE_SUBLIMINAL_CONFIG_DIR; DST_SUBLIMINAL=$LA_SUBLIMINAL_CONFIG_DIR
        SRC_QBIT=$SNODE_QBIT_CONFIG_DIR; DST_QBIT=$LA_QBIT_CONFIG_DIR
        SRC_AUDIO_CACHE=$SNODE_AUDIO_CACHE_DIR; DST_AUDIO_CACHE=$LA_AUDIO_CACHE_DIR
        ;;
    *)
        echo "Usage: $0 [la-to-snode|snode-to-la]"
        exit 1
        ;;
esac

RSYNC_SSH=("$SSH_BIN" -o BatchMode=yes)
if [[ "$SYNC_STRICT_HOST_KEY_CHECKING" == "false" ]]; then
    RSYNC_SSH+=("-o" "StrictHostKeyChecking=no" "-o" "UserKnownHostsFile=/dev/null")
fi
RSYNC_SSH+=("-o" "ConnectTimeout=$SYNC_SSH_CONNECT_TIMEOUT")

# rsync refuses "host:path host:path" (both sides remote) - it only works as
# local<->remote. This script is meant to run ON one of the two nodes, so
# whichever side matches an address on this machine's own interfaces is
# treated as a bare local path; only the other side gets a host: prefix.
_host_part() { printf '%s' "${1#*@}"; }

_is_local_host() {
    local h
    h=$(_host_part "$1")
    if [[ "$h" == "localhost" || "$h" == "127.0.0.1" ]]; then
        return 0
    fi
    ip -o addr show 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | grep -qx "$h"
}

IS_SRC_LOCAL=false
IS_DST_LOCAL=false
_is_local_host "$SRC_HOST" && IS_SRC_LOCAL=true
_is_local_host "$DST_HOST" && IS_DST_LOCAL=true

if [[ "$IS_SRC_LOCAL" == "false" && "$IS_DST_LOCAL" == "false" ]]; then
    echo "Neither $SRC_HOST nor $DST_HOST resolves to an address on this machine."
    echo "Run this script ON the la or snode host itself (not from a third machine)."
    exit 1
fi

# ref <is_local> <host> <path> -> "path" if local, "host:path" if remote.
ref() {
    if [[ "$1" == "true" ]]; then
        printf '%s' "$3"
    else
        printf '%s:%s' "$2" "$3"
    fi
}

mkdir_dst() {
    local dst_dir=$1
    if [[ "$IS_DST_LOCAL" == "true" ]]; then
        mkdir -p "$dst_dir"
    else
        "${RSYNC_SSH[@]}" "$DST_HOST" "mkdir -p '$dst_dir'"
    fi
}

RSYNC_ARGS=(-az --stats)
if [[ "$SYNC_DRY_RUN" == "true" ]]; then
    RSYNC_ARGS+=(--dry-run --itemize-changes)
fi

DELETE_ARGS=()
if [[ "$SYNC_DELETE" == "true" ]]; then
    DELETE_ARGS+=(--delete)
fi

# Video payload extensions to exclude from the movies/series mirror.
VIDEO_EXCLUDES=(
    --exclude '*.mp4' --exclude '*.MP4'
    --exclude '*.mkv' --exclude '*.MKV'
    --exclude '*.mpg' --exclude '*.MPG'
    --exclude '*.mpeg' --exclude '*.MPEG'
    --exclude '*.avi' --exclude '*.AVI'
    --exclude '*.m4v' --exclude '*.M4V'
    --exclude '*.ts' --exclude '*.TS'
    --exclude '*.webm' --exclude '*.WEBM'
)

echo "== Syncing app state: $DIRECTION =="
echo "   dry_run=$SYNC_DRY_RUN delete=$SYNC_DELETE include_audio_cache=$SYNC_INCLUDE_AUDIO_CACHE"

FAILED_LEGS=()

# A single directory's mkdir/rsync failure must not abort the rest of the
# legs (e.g. a not-yet-created /data mount point on the destination host
# should not prevent the small, more important state folders from syncing).
run_leg() {
    local label=$1
    local dst_dir=$2
    shift 2
    if ! mkdir_dst "$dst_dir" 2>&1; then
        echo "WARN: could not create destination dir for '$label' - skipping this leg."
        FAILED_LEGS+=("$label")
        return
    fi
    if ! "$@"; then
        echo "WARN: rsync failed for '$label'."
        FAILED_LEGS+=("$label")
    fi
}

echo "-- app metadata: user profiles, roster, feeds, catalog caches (full mirror) --"
run_leg "user-profiles" "$DST_METADATA" \
    "$RSYNC_BIN" "${RSYNC_ARGS[@]}" "${DELETE_ARGS[@]}" -e "${RSYNC_SSH[*]}" \
    "$(ref "$IS_SRC_LOCAL" "$SRC_HOST" "$SRC_METADATA")/" "$(ref "$IS_DST_LOCAL" "$DST_HOST" "$DST_METADATA")/"

echo "-- catalog metadata (full mirror, read-only mount on both sides) --"
run_leg "catalog-metadata" "$DST_CATALOG" \
    "$RSYNC_BIN" "${RSYNC_ARGS[@]}" "${DELETE_ARGS[@]}" -e "${RSYNC_SSH[*]}" \
    "$(ref "$IS_SRC_LOCAL" "$SRC_HOST" "$SRC_CATALOG")/" "$(ref "$IS_DST_LOCAL" "$DST_HOST" "$DST_CATALOG")/"

echo "-- movies library (everything except video files) --"
run_leg "movies" "$DST_MOVIES" \
    "$RSYNC_BIN" "${RSYNC_ARGS[@]}" -e "${RSYNC_SSH[*]}" \
    "${VIDEO_EXCLUDES[@]}" \
    "$(ref "$IS_SRC_LOCAL" "$SRC_HOST" "$SRC_MOVIES")/" "$(ref "$IS_DST_LOCAL" "$DST_HOST" "$DST_MOVIES")/"

echo "-- series library (everything except video files) --"
run_leg "series" "$DST_SERIES" \
    "$RSYNC_BIN" "${RSYNC_ARGS[@]}" -e "${RSYNC_SSH[*]}" \
    "${VIDEO_EXCLUDES[@]}" \
    "$(ref "$IS_SRC_LOCAL" "$SRC_HOST" "$SRC_SERIES")/" "$(ref "$IS_DST_LOCAL" "$DST_HOST" "$DST_SERIES")/"

echo "-- archive/tobedel (full mirror) --"
run_leg "archive" "$DST_ARCHIVE" \
    "$RSYNC_BIN" "${RSYNC_ARGS[@]}" "${DELETE_ARGS[@]}" -e "${RSYNC_SSH[*]}" \
    "$(ref "$IS_SRC_LOCAL" "$SRC_HOST" "$SRC_ARCHIVE")/" "$(ref "$IS_DST_LOCAL" "$DST_HOST" "$DST_ARCHIVE")/"

echo "-- subliminal config (full mirror) --"
run_leg "subliminal-config" "$DST_SUBLIMINAL" \
    "$RSYNC_BIN" "${RSYNC_ARGS[@]}" -e "${RSYNC_SSH[*]}" \
    "$(ref "$IS_SRC_LOCAL" "$SRC_HOST" "$SRC_SUBLIMINAL")/" "$(ref "$IS_DST_LOCAL" "$DST_HOST" "$DST_SUBLIMINAL")/"

echo "-- qbittorrent config (full mirror) --"
run_leg "qbittorrent-config" "$DST_QBIT" \
    "$RSYNC_BIN" "${RSYNC_ARGS[@]}" -e "${RSYNC_SSH[*]}" \
    "$(ref "$IS_SRC_LOCAL" "$SRC_HOST" "$SRC_QBIT")/" "$(ref "$IS_DST_LOCAL" "$DST_HOST" "$DST_QBIT")/"

if [[ "$SYNC_INCLUDE_AUDIO_CACHE" == "true" ]]; then
    echo "-- audio playback cache (opt-in, can be large) --"
    run_leg "audio-cache" "$DST_AUDIO_CACHE" \
        "$RSYNC_BIN" "${RSYNC_ARGS[@]}" -e "${RSYNC_SSH[*]}" \
        "$(ref "$IS_SRC_LOCAL" "$SRC_HOST" "$SRC_AUDIO_CACHE")/" "$(ref "$IS_DST_LOCAL" "$DST_HOST" "$DST_AUDIO_CACHE")/"
fi

if [[ "$SYNC_DRY_RUN" == "true" ]]; then
    echo "App-folder sync dry-run completed: $DIRECTION"
else
    echo "App-folder sync completed: $DIRECTION"
fi

if [[ ${#FAILED_LEGS[@]} -gt 0 ]]; then
    echo "Legs that failed or were skipped: ${FAILED_LEGS[*]}"
    exit 1
fi
